# Environment
.env

# Output - never commit generated CVs or JDs
output/

# JD drop folder - may contain confidential job descriptions
jds/

# Database — local data, never committed
data/

# Demo folder — intentionally committed (fictional data only, safe for git)
# demo/atat.db and demo/cv-library/ are seed assets, not personal data

# Personal prompt additions - never commit
prompts/personal_additions.md
prompts/cover_letter_personal.md

# Windows launcher - hardcodes this machine's WSL path, not portable
atat_launch.bat

# Fonts - downloaded locally, not committed
fonts/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# Node
web/node_modules/
web/.next/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
.claude/

# Logs - generation failure dumps may contain CV and job ad content
logs/
