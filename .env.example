# ── Demo mode ────────────────────────────────────────────────────────────────
# When true, CV library and DB paths are fixed to ./demo/ (convention-based).
# No additional path config is needed — set this flag and restart both servers.
# The UI banner is driven by the /settings API response — no frontend flag required.
DEMO_MODE=false

# ── Paths ────────────────────────────────────────────────────────────────────
# Ignored when DEMO_MODE=true.
CV_LIBRARY_PATH=../cv-library

# ── Database ───────────────────────────────────────────────────────────────────
# Ignored when DEMO_MODE=true (uses ./demo/atat.db instead).
DB_PATH=./data/atat.db

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Judge model — Tier 2 accuracy checks. Cheaper/faster than LLM_MODEL.
# Anthropic: claude-haiku-4-5-20251001
# OpenAI:    gpt-4o-mini
JUDGE_MODEL=claude-haiku-4-5-20251001

# Retry model — section-level rewrites during human-in-the-loop review.
# No thinking budget is applied. Defaults to JUDGE_MODEL if not set.
# Override to a mid-tier model (e.g. claude-sonnet-4-6) if retry quality is insufficient.
RETRY_MODEL=claude-haiku-4-5-20251001

# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ── Model Parameters ──────────────────────────────────────────────────────────
TEMPERATURE=0.3
MAX_OUTPUT_TOKENS=8192
THINKING_BUDGET=8000
ENABLE_CACHING=true

# ── Rendering ─────────────────────────────────────────────────────────────────
RENDER_PDF=true

# ── Scheduler / auto-ghost ────────────────────────────────────────────────────
# AUTO_GHOST_ENABLED        — set to false to disable the background ghost check entirely
# AUTO_GHOST_DAYS           — days of inactivity before an application is marked ghosted
#                             Eligible statuses: applied, acknowledged, interviewing, case_study
# SCHEDULER_INTERVAL_HOURS  — how often the ghost check runs (in hours)
AUTO_GHOST_ENABLED=true
AUTO_GHOST_DAYS=21
SCHEDULER_INTERVAL_HOURS=6
# AUTO_GHOST_USE_WINDOW     — ghost after the response window learned from your data instead
#                             of AUTO_GHOST_DAYS (the day by which 90% of first answers arrive)
AUTO_GHOST_USE_WINDOW=false

# ── Insights ──────────────────────────────────────────────────────────────────
# WEEKLY_SCREEN_TARGET — screens a week you're aiming for (0 = none); the Insights page
#                        shows how many applications a week that takes at your screen rate
WEEKLY_SCREEN_TARGET=0

# ── Gmail inbox sync ──────────────────────────────────────────────────────────
# Read-only Gmail access that links application emails (acknowledgements, rejections,
# interview invites, offers) to applications, for review on the Inbox page.
# Setup: create a Google Cloud OAuth client of type "Desktop app" with the Gmail API
# enabled, save its JSON to GMAIL_CREDENTIALS_PATH, then run once:
#     python -m pipeline.inbox.auth
# GMAIL_ENABLED               — poll on a schedule (manual "Sync now" works either way)
# GMAIL_SYNC_INTERVAL_MINUTES — how often the scheduled sync runs
# GMAIL_MAX_PER_SYNC          — max messages fetched per run
# GMAIL_MAX_LOOKBACK_DAYS     — never read mail older than this many days (first sync or after a gap)
# INBOX_MODEL                 — model for triage/classification (defaults to JUDGE_MODEL)
# INBOX_CLASSIFIER            — api: classify with INBOX_MODEL during the sync (costs API tokens)
#                               agent: the sync only gathers mail; an AI agent classifies it over
#                               MCP (get_untriaged_emails / classify_inbox_emails) — no API calls
GMAIL_ENABLED=false
GMAIL_SYNC_INTERVAL_MINUTES=30
# GMAIL_CREDENTIALS_PATH=data/gmail/client_secret.json
# GMAIL_TOKEN_PATH=data/gmail/token.json
GMAIL_MAX_PER_SYNC=200
GMAIL_MAX_LOOKBACK_DAYS=90
# INBOX_MODEL=claude-haiku-4-5-20251001
INBOX_CLASSIFIER=api

# ── Pipeline Config ───────────────────────────────────────────────────────────
JDS_PATH=./jds
OUTPUT_PATH=./output
LOG_LEVEL=INFO

# ── Deployment / access (see README "Deploying to a home server") ─────────────
# ATAT_HOME — set in the REAL environment (not here) to run a separate instance with its
#   own database, outputs, logs, personal prompts, Gmail token and .env. docker-compose does
#   this for you.
# ATAT_PASSWORD — require this password to use the app. Always set it for anything reachable
#   from a network; leave unset only on localhost.
# ATAT_LOCK_ADVANCED — true makes the AI provider/keys/models/paths and shared prompts
#   read-only in the app (for a non-technical user).
# FONTS_PATH — where the Poppins .ttf files are (default ./fonts)
# ATAT_PASSWORD=
# ATAT_LOCK_ADVANCED=false
# FONTS_PATH=./fonts

# ── CV shape (per instance) ───────────────────────────────────────────────────
# Profile shape: written into the generation and retry prompts and checked by the judge.
# PROFILE_PARAGRAPHS=2
# PROFILE_WORDS_MIN=80
# PROFILE_WORDS_MAX=120
# EARLIER_EXPERIENCE_HEADING=Earlier experience
# PDF look: rule beside section headings (full | short | none) and underlined links.
# HEADING_RULE=full
# Letter-spacing of headings in points. Keep it at or below 0.5: wider and ATS parsers read "P R O F I L E".
# HEADING_TRACKING=0.5
# LINK_UNDERLINE=true
# Run the judges (tiers 1-3) as soon as a CV is generated.
# AUTO_JUDGE=true
