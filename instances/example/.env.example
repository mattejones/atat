# This instance's settings. Copy to instances/<name>/.env (next to compose.env).
# The settings page in the app edits some of these; changes apply after a restart:
#   docker compose --env-file instances/<name>/compose.env -p atat-<name> restart api

# ── Access ────────────────────────────────────────────────────────────────────
# The password for this instance. REQUIRED for anything reachable from a network.
ATAT_PASSWORD=change-me-to-something-long
# Make the AI provider, keys, models, paths and the shared prompts read-only in the app,
# so a non-technical user can't break the setup. Change them here instead.
ATAT_LOCK_ADVANCED=true

# ── AI ────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=
# JUDGE_MODEL=
# RETRY_MODEL=

# ── Gmail (optional) ──────────────────────────────────────────────────────────
# Connecting is a one-time step done on a machine with a browser — see README. The
# token then lives in this instance's data/gmail/ folder.
GMAIL_ENABLED=false
# Without an MCP client, the app itself must classify mail:
INBOX_CLASSIFIER=api
