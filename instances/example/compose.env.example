# Compose settings for one instance. Copy this directory to instances/<name>/ and pass
# the file with:  docker compose --env-file instances/<name>/compose.env -p atat-<name> up -d --build

COMPOSE_PROJECT_NAME=atat-example

# This person's data directory (becomes /data in the containers). Holds their .env,
# data/atat.db, output/, logs/, prompts/ and data/gmail/.
ATAT_INSTANCE_DIR=./instances/example

# This person's CV library (experience/, personas/, skills/, meta/ — see README).
# Use a separate library per person: it is what the generated CVs are built from.
CV_LIBRARY_DIR=/srv/atat/example/cv-library

# Poppins .ttf files used to render PDFs (shared by every instance).
FONTS_DIR=./fonts

# The one published port. Give each instance its own.
WEB_PORT=18080
WEB_BIND=127.0.0.1

# Optional MCP server port (only with --profile mcp), localhost only.
MCP_PORT=8765

# uid/gid that own the instance directory (run `id -u` / `id -g`).
ATAT_UID=1000
ATAT_GID=1000

TZ=Europe/London
